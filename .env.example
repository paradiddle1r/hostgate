# Supabase (สาธารณะ ใส่ลงใน Vercel ได้เลย)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# Supabase service role (ลับ! ห้าม expose ฝั่ง client — ใช้โดย admin console,
# Channex webhook receiver และ cron เท่านั้น)
SUPABASE_SERVICE_ROLE_KEY=

# ── Channex.io channel manager ──────────────────────────────────────────────
# staging = https://staging.channex.io (คีย์ staging), production = https://app.channex.io
CHANNEX_BASE_URL=https://staging.channex.io
CHANNEX_API_KEY=
# secret ที่เราแนบไปกับ webhook ที่ลงทะเบียนไว้ (Channex ไม่มี HMAC) — สุ่มยาวๆ
CHANNEX_WEBHOOK_SECRET=

# ── Platform admin console (admin.hostgate.app) ─────────────────────────────
# อีเมลที่เข้าหน้า /admin ได้ (คั่นด้วย ,) — bootstrap ก่อนมีแถวใน platform_admins
PLATFORM_ADMIN_EMAILS=pornchailin@gmail.com

# ── Cron auth ────────────────────────────────────────────────────────────────
# Vercel cron ส่ง Authorization: Bearer <CRON_SECRET> อัตโนมัติ; pg_cron ตั้งเอง
CRON_SECRET=

# Base URL ของเว็บ (ใช้สร้าง webhook callback URL)
NEXT_PUBLIC_SITE_URL=https://hostgate.app
