# Supabase (สาธารณะ ใส่ลงใน Vercel ได้เลย)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# Booking-confirmation email sender (lib/mailer.ts). Without this set, the
# guest "resend confirmation email" action fails gracefully with HG-MAIL-500
# instead of sending — get a key at https://resend.com.
RESEND_API_KEY=
RESEND_FROM_EMAIL=HostGate <bookings@hostgate.app>
